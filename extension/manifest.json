{
  "manifest_version": 3,
  "name": "Inner Garden · 美日心灵",
  "version": "1.2.0",
  "key": "",
  "description": "本地优先的新标签页工作区：整理标签、专注计时、安排日历与周计划、记录日课和笔记；可选账号同步。",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://*.api.tcloudbasegateway.com/*",
    "https://*.app.tcloudbase.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Inner Garden · 美日心灵",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "migration.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
